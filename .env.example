# Configuration technique (copier en .env). Les paramètres MÉTIER (hôtel, TVA, taxe de séjour,
# imprimantes...) se règlent dans l'application : Administration > Paramètres.

# Réseau : 0.0.0.0 rend l'application accessible aux autres postes du réseau local
HOST=0.0.0.0
PORT=8000

# Base de données (par défaut data/hotel.db, mode WAL)
# DATABASE_URL=sqlite+aiosqlite:///C:/Hotel/data/hotel.db

# Clé de signature des sessions : générée automatiquement dans data/.secret_key si absente
# SECRET_KEY=une-longue-chaine-aleatoire

# Cookies réservés à HTTPS (activer derrière un reverse proxy TLS)
COOKIE_SECURE=false
# Durée de session en secondes (12 h)
SESSION_MAX_AGE=43200

# Sauvegardes automatiques
# BACKUP_DIR=D:/Sauvegardes/hotel
BACKUP_RETENTION=30

# Tâches planifiées (audit de nuit, sauvegarde quotidienne)
SCHEDULER_ENABLED=true

# Sécurité de la connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

LOG_LEVEL=INFO
