# Copier ce fichier en .env pour personnaliser l'installation (facultatif).

# Base de données (par défaut : data/hotel.db, copié depuis data/hotel_template.db au premier lancement)
# DATABASE_URL=sqlite:///data/hotel.db

# Clé de signature des sessions. Si absente, elle est générée une fois dans data/.secret_key.
# SECRET_KEY=change-me-to-a-long-random-string

# Réseau d'écoute
# HOST=0.0.0.0
# PORT=8000
